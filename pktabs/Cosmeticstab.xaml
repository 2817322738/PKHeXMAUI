<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PKHeXMAUI.Cosmeticstab"
             Title="外观">
    <RefreshView x:Name="CosmeticsRefresh">
        <ScrollView>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Grid.Row="0"
                       x:FieldModifier="public"
                       x:Name="pic"
                       Source="iconp.png"
                       HeightRequest="50"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"/>

                <Image Source="rare_icon.png"
                       Grid.Column="1"
                       Grid.Row="0"
                       x:Name="shinysparklessprite"
                       HeightRequest="16"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"/>

                <Image Source="a_egg.png"
                       Grid.Column="0"
                       Grid.Row="0"
                       x:Name="eggsprite"
                       HeightRequest="40"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       IsVisible="false"/>

                <Image Grid.Column="1"
                       Grid.Row="0"
                       x:Name="itemsprite"
                       HeightRequest="16"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       IsVisible="false"/>

                <!-- Affixed Ribbon -->
                <ImageButton Grid.Row="2"
                             Grid.Column="4"
                             VerticalOptions="End"
                             HorizontalOptions="Start"
                             Source="ribbon_affix_none.png"
                             IsVisible="False"
                             Clicked="OpenRibbonEditor"
                             x:Name="AffixedRibbonSprite"/>

                <!-- 身高 -->
                <Label Grid.Row="1"
                       Grid.Column="0"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Text="身高："
                       IsVisible="false"
                       x:Name="HeightLabel"></Label>

                <Editor Grid.Row="1"
                        Grid.Column="1"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="0"
                        x:Name="Heightdisplay"
                        TextChanged="applyheight"
                        IsVisible="false"
                        Keyboard="Numeric"/>

                <Editor IsReadOnly="True"
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        x:Name="HeightAbsoluteEditor"
                        IsVisible="false"/>

                <Label Grid.Row="1"
                       Grid.Column="3"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="HeighDetailLabel"
                       IsVisible="false"/>

                <!-- 体重 -->
                <Label Grid.Row="2"
                       Grid.Column="0"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Text="体重："
                       IsVisible="false"
                       x:Name="WeightLabel"/>

                <Editor Grid.Row="2"
                        Grid.Column="1"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="0"
                        x:Name="Weightdisplay"
                        TextChanged="applyweight"
                        IsVisible="false"
                        Keyboard="Numeric"/>

                <Editor IsReadOnly="True"
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        x:Name="WeightAbsoluteEditor"
                        IsVisible="false"/>

                <Label Grid.Row="2"
                       Grid.Column="3"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="WeightDetailLabel"
                       IsVisible="false"/>

                <!-- 体型 / CP -->
                <Label x:Name="scalelabel"
                       Grid.Row="3"
                       Grid.Column="0"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Text="体型："
                       IsVisible="false"/>

                <Editor Grid.Row="3"
                        Grid.Column="1"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="0"
                        x:Name="scaledisplay"
                        TextChanged="applyscale"
                        IsVisible="false"
                        Keyboard="Numeric"/>

                <CheckBox Grid.Row="3"
                          Grid.Column="1"
                          x:Name="AutoCP"
                          HorizontalOptions="End"
                          IsVisible="false"
                          CheckedChanged="AutoCalcCP"></CheckBox>

                <Label Grid.Row="3"
                       Grid.Column="2"
                       Text="自动"
                       IsVisible="false"
                       x:Name="cpAutoLabel"/>

                <Label Grid.Row="3"
                       Grid.Column="3"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="ScaleDetailLabel"
                       IsVisible="false"/>

                <Image IsVisible="false"
                       Grid.Column="4"
                       Grid.Row="3"
                       HorizontalOptions="Start"
                       x:Name="SizeMarkImage"
                       HeightRequest="32"/>

                <!-- 缎带和回忆 -->
                <Button Grid.Row="4"
                        Margin="0,16,0,0"
                        Grid.Column="0"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        x:Name="ribbons"
                        Text="缎带"
                        Clicked="openribbons"
                        Grid.ColumnSpan="2"></Button>

                <Button Grid.Row="4"
                        Margin="0,16,0,0"
                        Grid.Column="4"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        x:Name="memoriesbutton"
                        Text="回忆"
                        Clicked="openmemories"
                        IsVisible="false"
                        Grid.ColumnSpan="2"/>

                <Button Grid.Row="4"
                        Margin="0,16,0,0"
                        Grid.Column="2"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        x:Name="MedalEditorButton"
                        Text="奖章"
                        Clicked="openmedaleditor"
                        IsVisible="false"
                        Grid.ColumnSpan="2"/>

                <!-- 叶子和王冠 -->
                <CheckBox Grid.Row="5"
                          Grid.Column="0"
                          HorizontalOptions="Start"
                          VerticalOptions="Center"
                          x:Name="LeafCheckBox1"
                          IsVisible="false"
                          CheckedChanged="ApplyLeaf1"/>

                <Image Grid.Row="5"
                       Grid.Column="1"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="LeafSprite1"
                       Source="leaf.png"
                       IsVisible="false"/>

                <CheckBox Grid.Row="5"
                          Grid.Column="2"
                          HorizontalOptions="Start"
                          VerticalOptions="Center"
                          x:Name="LeafCheckBox2"
                          IsVisible="false"
                          CheckedChanged="ApplyLeaf1"/>

                <Image Grid.Row="5"
                       Grid.Column="3"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="LeafSprite2"
                       Source="leaf.png"
                       IsVisible="false"/>

                <CheckBox Grid.Row="5"
                          Grid.Column="4"
                          HorizontalOptions="Start"
                          VerticalOptions="Center"
                          x:Name="LeafCheckBox3"
                          IsVisible="false"
                          CheckedChanged="ApplyLeaf1"/>

                <Image Grid.Row="5"
                       Grid.Column="5"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="LeafSprite3"
                       Source="leaf.png"
                       IsVisible="false"/>

                <CheckBox Grid.Row="6"
                          Grid.Column="0"
                          HorizontalOptions="Start"
                          VerticalOptions="Center"
                          x:Name="LeafCheckBox4"
                          IsVisible="false"
                          CheckedChanged="ApplyLeaf1"/>

                <Image Grid.Row="6"
                       Grid.Column="1"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="LeafSprite4"
                       Source="leaf.png"
                       IsVisible="false"/>

                <CheckBox Grid.Row="6"
                          Grid.Column="2"
                          HorizontalOptions="Start"
                          VerticalOptions="Center"
                          x:Name="LeafCheckBox5"
                          IsVisible="false"
                          CheckedChanged="ApplyLeaf1"/>

                <Image Grid.Row="6"
                       Grid.Column="3"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="LeafSprite5"
                       Source="leaf.png"
                       IsVisible="false"/>

                <CheckBox Grid.Row="6"
                          Grid.Column="4"
                          HorizontalOptions="Start"
                          VerticalOptions="Center"
                          x:Name="CrownCheckbox"
                          IsVisible="false"
                          CheckedChanged="ApplyLeaf1"/>

                <Image Grid.Row="6"
                       Grid.Column="5"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       x:Name="CrownSprite"
                       Source="crown.png"
                       IsVisible="false"/>

                <!-- 华丽大赛能力 -->
                <Label Grid.Row="7"
                       Grid.Column="2"
                       Grid.ColumnSpan="2"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Text="华丽大赛能力"/>

                <Label Grid.Row="8"
                       Grid.Column="1"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Text="帅气"/>

                <Editor x:Name="Coolstats"
                        Grid.Row="9"
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="0"
                        TextChanged="applycoolness"
                        Keyboard="Numeric"/>

                <Label Grid.Row="8"
                       Grid.Column="2"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Text="美丽"/>

                <Editor x:Name="Beautystats"
                        Grid.Row="9"
                        Grid.Column="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="0"
                        TextChanged="makepretty"
                        Keyboard="Numeric"/>

                <Label Grid.Row="8"
                       Grid.Column="3"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Text="可爱"/>

                <Editor x:Name="Cutestats"
                        Grid.Row="9"
                        Grid.Column="3"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="0"
                        TextChanged="applycuteness"
                        Keyboard="Numeric"/>

                <Label Grid.Row="10"
                       Grid.Column="1"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Text="聪明"/>

                <Editor x:Name="Cleverstats"
                        Grid.Row="11"
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="0"
                        TextChanged="makesmart"
                        Keyboard="Numeric"/>

                <Label Grid.Row="10"
                       Grid.Column="2"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Text="强壮"/>

                <Editor x:Name="toughstats"
                        Grid.Row="11"
                        Grid.Column="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="0"
                        TextChanged="GoToTheGym"
                        Keyboard="Numeric"/>

                <Label Grid.Row="10"
                       Grid.Column="3"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Text="光泽"/>

                <Editor x:Name="sheenstats"
                        Grid.Row="11"
                        Grid.Column="3"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="0"
                        TextChanged="MakeMeSparkle"
                        Keyboard="Numeric"/>

            </Grid>

        </ScrollView>
    </RefreshView>
</ContentPage>
